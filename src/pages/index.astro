---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import MarketplaceLinks from '../components/MarketplaceLinks.astro';
import CertIcon from '../components/CertIcon.astro';
import { certifications } from '../data/site';
import { categories, featured } from '../data/products';
const featuredTones = [categories[0].color, categories[2].color, categories[3].color];
const featuredClaims = [categories[0].claims, categories[2].claims, categories[3].claims];
---
<BaseLayout title="Healthy snacks, happy little munchers" description="The Munching Queen creates thoughtfully made Indonesian snacks for families, using real ingredients and joyful flavours.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1><span data-en="Crafted for Little Tummies." data-id="Dibuat untuk Perut Mungil.">Crafted for Little Tummies.</span> <em data-en="Loved by every age." data-id="Disukai Segala Usia.">Loved by every age.</em></h1>
        <p class="lede" data-en="We hope your little ones love them as much as we do. Happy Munching!" data-id="Semoga si kecil menyukainya seperti kami. Selamat Ngemil!">We hope your little ones love them as much as we do. Happy Munching!</p>
      </div>
      <div class="hero-photo">
        <img src="/images/lifestyle/hero-child-fish-cheese.webp" alt="A smiling child enjoying The Munching Queen Fish and Cheese snacks" width="1080" height="1350" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true"><div class="marquee-track"><span data-en="Kids-Friendly Snack" data-id="Camilan Ramah Anak">Kids-Friendly Snack</span><span data-en="Crafted for Little Tummies, Loved by Every Age" data-id="Dibuat untuk Perut Mungil, Disukai Segala Usia">Crafted for Little Tummies, Loved by Every Age</span><span data-en="Healthier Option Better" data-id="Pilihan Lebih Sehat dan Lebih Baik">Healthier Option Better</span><span data-en="Kids-Friendly Snack" data-id="Camilan Ramah Anak">Kids-Friendly Snack</span><span data-en="Crafted for Little Tummies, Loved by Every Age" data-id="Dibuat untuk Perut Mungil, Disukai Segala Usia">Crafted for Little Tummies, Loved by Every Age</span><span data-en="Healthier Option Better" data-id="Pilihan Lebih Sehat dan Lebih Baik">Healthier Option Better</span></div></div>

  <section class="section tone-blush pantry-preview" id="about-us">
    <div class="container story-grid">
      <div class="story-photo reveal"><img src="/images/lifestyle/fish-cheese.webp" alt="The Munching Queen Fish and Cheese snacks styled for sharing" width="1080" height="1350" loading="lazy" /></div>
      <div class="story-card reveal">
        <span class="eyebrow" data-en="About Us" data-id="Tentang Kami">About Us</span>
        <h2 data-en="Hi, everyone!" data-id="Halo, semuanya!">Hi, everyone!</h2>
        <div class="story-copy">
          <p data-en="We are a group of parents and snack enthusiasts from Surabaya, Indonesia. Growing up, we saw how kerupuk became a cornerstone of Indonesia's dining culture, much like sambal." data-id="Kami adalah sekelompok orang tua dan pencinta camilan dari Surabaya, Indonesia. Sejak kecil, kami melihat kerupuk menjadi bagian penting dari budaya makan Indonesia, sama seperti sambal.">We are a group of parents and snack enthusiasts from Surabaya, Indonesia. Growing up, we saw how kerupuk became a cornerstone of Indonesia's dining culture, much like sambal.</p>
          <p data-en="We launched Kroepoek Waroeng at a food expo in Dubai, UAE, in 2016. The enthusiasm of international customers for our Indonesian crackers inspired us to share Indonesia's food heritage through deliciously flavoured, ready-to-eat kerupuk under our brand, The Munching Queen." data-id="Pada 2016, kami meluncurkan Kroepoek Waroeng di sebuah pameran makanan di Dubai, Uni Emirat Arab. Antusiasme pelanggan internasional terhadap kerupuk Indonesia menginspirasi kami untuk memperkenalkan warisan kuliner Indonesia melalui kerupuk siap santap dengan rasa lezat di bawah merek The Munching Queen.">We launched Kroepoek Waroeng at a food expo in Dubai, UAE, in 2016. The enthusiasm of international customers for our Indonesian crackers inspired us to share Indonesia's food heritage through deliciously flavoured, ready-to-eat kerupuk under our brand, The Munching Queen.</p>
          <p data-en="During the pandemic, we searched for more locally made, kid-friendly snacks without ingredients we did not want for our then three-year-old son. Having lived in Melbourne made us especially mindful of ingredients for little ones, but we could not find many options he enjoyed." data-id="Saat pandemi, kami mencari lebih banyak camilan lokal yang ramah anak, tanpa bahan yang tidak kami inginkan untuk putra kami yang saat itu berusia tiga tahun. Pengalaman tinggal di Melbourne membuat kami semakin cermat memilih bahan untuk anak-anak, tetapi kami belum menemukan banyak pilihan yang ia sukai.">During the pandemic, we searched for more locally made, kid-friendly snacks without ingredients we did not want for our then three-year-old son. Having lived in Melbourne made us especially mindful of ingredients for little ones, but we could not find many options he enjoyed.</p>
          <p data-en="So we experimented with countless natural ingredients in our own kitchen to create more affordable, better snack options children would love. We wanted to preserve the quality and familiar crunch of kerupuk. That is how our Fish & Cheese series was born." data-id="Karena itu, kami bereksperimen dengan berbagai bahan alami di dapur sendiri untuk menciptakan pilihan camilan yang lebih terjangkau, lebih baik, dan disukai anak-anak. Kami tetap ingin mempertahankan kualitas serta kerenyahan kerupuk yang familiar. Dari situlah seri Fish & Cheese lahir.">So we experimented with countless natural ingredients in our own kitchen to create more affordable, better snack options children would love. We wanted to preserve the quality and familiar crunch of kerupuk. That is how our Fish & Cheese series was born.</p>
        </div>
        <blockquote class="pullquote" data-en="We believe quality is key and that better snacks can taste every bit as good. We hope your little ones love them as much as we do. Happy munching!" data-id="Kami percaya kualitas adalah kunci dan camilan yang lebih baik tetap bisa terasa sama lezatnya. Semoga si kecil menyukainya seperti kami. Selamat ngemil!">We believe quality is key and that better snacks can taste every bit as good. We hope your little ones love them as much as we do. Happy munching!</blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="products-preview-title" data-en="PRODUCTS" data-id="PRODUK">PRODUCTS</h2>
      <div class="card-grid">
        {featured.map((product, index) => <ProductCard product={product} tone={featuredTones[index]} claims={featuredClaims[index]} />)}
      </div>
      <div class="button-row"><a class="button" href="/products" data-en="Explore all products" data-id="Lihat semua produk">Explore all products</a></div>
    </div>
  </section>

  <section class="section certification-section">
    <div class="container certification-layout">
      <header class="certification-heading">
        <h2 class="certification-title" data-en="Our Certification" data-id="Sertifikasi Kami">Our Certification</h2>
      </header>
      <div class="cert-grid">
        {certifications.map((cert) => (
          <article class="cert-card reveal">
            <div class="cert-mark">
              <CertIcon type={cert.id} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section market-section" id="shop-online"><div class="container"><span class="eyebrow" data-en="Online Marketplace" data-id="Marketplace Online">Online Marketplace</span><MarketplaceLinks /></div></section>
</BaseLayout>
